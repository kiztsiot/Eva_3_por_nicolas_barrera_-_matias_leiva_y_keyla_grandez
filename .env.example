# ============================================================
# Variables de entorno — Centro de Negocios SERCOTEC
# Copia este archivo como .env y completa los valores reales
# ============================================================

# URL base de la API (JSON Server local o CMS en producción)
# Desarrollo local con JSON Server: http://localhost:3001
# Producción : https://tu-api.com/api
VITE_API_URL=http://localhost:3001

# Clave de reCAPTCHA v3 (opcional, para protección avanzada anti-bots)
#  Para Obtener una clave en: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_KEY=
